# TypeSafe (Jev)
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest

# LLM baseline, any OpenAI-compatible chat/completions endpoint
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3-flash
# list prices in USD per million tokens, always the paid price even on a free tier
LLM_PRICE_IN=
LLM_PRICE_OUT=
# requests per minute cap for the LLM run (free tiers), 0 = no cap
LLM_RPM=10
# extra JSON merged into the LLM request body. Gemini 3 cannot switch thinking off, "low" is the minimum:
LLM_EXTRA_BODY={"reasoning_effort": "low"}
# grid name in reference_results.csv if it differs from LLM_MODEL (e.g. google/gemini-3-flash-preview)
LLM_GRID_MODEL=
