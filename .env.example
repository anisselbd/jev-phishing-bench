# TypeSafe (Jev)
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest

# LLM baseline. LLM_PROVIDER=anthropic calls the native Messages API (key from LLM_API_KEY or ANTHROPIC_API_KEY);
# LLM_PROVIDER=openai calls any OpenAI-compatible chat/completions endpoint.
LLM_PROVIDER=anthropic
LLM_BASE_URL=https://api.anthropic.com
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5
# OpenAI-compatible example: LLM_PROVIDER=openai, LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai, LLM_MODEL=gemini-3-flash-preview
# list prices in USD per million tokens, always the paid price even on a free tier
LLM_PRICE_IN=1.00
LLM_PRICE_OUT=5.00
# requests per minute cap for the LLM run (free tiers), 0 = no cap
LLM_RPM=0
# extra JSON merged into the LLM request body (Gemini 3 cannot switch thinking off: {"reasoning_effort": "low"} is the minimum)
LLM_EXTRA_BODY={}
# grid name in reference_results.csv if it differs from LLM_MODEL
LLM_GRID_MODEL=anthropic/claude-haiku-4.5
